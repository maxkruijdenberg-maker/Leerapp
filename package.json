{
  "name": "makelaar-academie",
  "version": "0.1.0",
  "description": "Persoonlijke offline leerapp voor Makelaar Wonen",
  "author": "Makelaar Academie",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win dir --x64 && node build/installer.cjs",
    "test:ui": "node tests/ui-dom.cjs"
  },
  "dependencies": {
    "adm-zip": "0.5.16"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "nl.makelaar.academie",
    "productName": "Makelaar Academie",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Makelaar-Academie-Setup-${version}.${ext}"
    }
  }
}